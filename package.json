{
  "name": "shadow-runner",
  "private": true,
  "version": "1.0.0",
  "description": "Shadow Runner – run through two worlds at once and switch between your physical self and your shadow.",
  "author": "Medin Turkes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:levels": "vite-node scripts/verify-levels.ts",
    "smoke": "node scripts/smoke.mjs",
    "build:mobile": "tsc --noEmit && node scripts/build-mobile.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
